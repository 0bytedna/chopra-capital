# Security-critical proxy headers for the Chopra Capital application.
# Include these directives in the production location block. X-Real-IP must be
# overwritten from the connection; never pass through a client-supplied value.
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
}
