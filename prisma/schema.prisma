// Chopra Capital — managed gold-fund platform.
// All money is Decimal (USDT). Convert to number only at the display edge
// via src/lib/money.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String  @id @default(cuid())
  email            String  @unique
  passwordHash     String
  role             Role    @default(USER)
  isCompanyAccount Boolean @default(false)

  // Deposit methods. Crypto (USDT) is always available; bank transfer and
  // cash are enabled by an admin per investor.
  bankTransferEnabled Boolean @default(false)
  cashEnabled         Boolean @default(false)

  fullName String?
  mobile   String?
  country  String?
  address  String? // Permanent Residential address
  city     String?
  state    String?

  kycStatus KycStatus @default(NOT_SUBMITTED)
  kycNote   String?

  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet                        Wallet?
  ledger                        LedgerEntry[]
  deposits                      Deposit[]
  depositAllocationBatches      DepositAllocationBatch[] @relation("DepositAllocationAdmin")
  brokerTransferBatches         BrokerTransferBatch[]    @relation("BrokerTransferAdmin")
  withdrawals                   Withdrawal[]
  tickets                       Ticket[]
  ticketMessages                TicketMessage[]
  kycDocuments                  KycDocument[]
  bankingDetail                 BankingDetail?
  internalTransfersSent         InternalTransfer[]       @relation("InternalTransferFrom")
  internalTransfersReceived     InternalTransfer[]       @relation("InternalTransferTo")
  internalTransfersAdministered InternalTransfer[]       @relation("InternalTransferAdmin")
  profitShareAllocations        ProfitShareAllocation[]
  profitSharePosition           ProfitSharePosition?
  companyProfitShareRuns        ProfitShareRun[]         @relation("ProfitShareCompany")
  administeredProfitShareRuns   ProfitShareRun[]         @relation("ProfitShareAdmin")
  reversedProfitShareRuns       ProfitShareRun[]         @relation("ProfitShareReversalAdmin")
}

model KycDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String // AADHAAR | PAN
  fileName  String
  filePath  String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Banking / financial details (one per investor)
// ---------------------------------------------------------------------------

model BankingDetail {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String?
  ifsc          String?
  upiId         String?
  accountType   String? // SAVINGS | CURRENT
  usdtAddress   String? // USDT wallet address (single network)
  usdtNetwork   String? // TRC20 | ERC20 | BEP20
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Wallet, pool & ledger — the unit/NAV accounting core
// ---------------------------------------------------------------------------

// queued: confirmed USDT waiting for the next weekly invest run.
// units:  the investor's share of the pool. Live value = units × NAV,
//         where NAV = MT5 equity ÷ total pool units.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  queued    Decimal  @default(0)
  units     Decimal  @default(0)
  updatedAt DateTime @updatedAt
}

// Single row tracking the whole pool. lastNav is the fallback when the live
// MT5 feed is unavailable.
model PoolState {
  id         String   @id @default("pool")
  totalUnits Decimal  @default(0)
  lastNav    Decimal  @default(1)
  updatedAt  DateTime @updatedAt
}

enum LedgerType {
  DEPOSIT // external USDT in -> queued
  INVEST // queued -> units (weekly invest run)
  WITHDRAWAL // queued/units -> external USDT out
  FEE // performance/network fee borne by the investor
  ADJUSTMENT // manual admin correction
}

// Append-only audit trail. amount = signed USDT. Unit movements also record
// units and the NAV used so the books can always be reconstructed.
model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LedgerType
  amount    Decimal
  units     Decimal?
  navPrice  Decimal?
  reference String?
  note      String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}

// Admin-authorized value movement between investor accounts. The paired ledger
// entries remain the accounting source of truth; this row is the audit record
// that ties both sides and the responsible administrator together.
model InternalTransfer {
  id             String   @id @default(cuid())
  fromUserId     String
  fromUser       User     @relation("InternalTransferFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId       String
  toUser         User     @relation("InternalTransferTo", fields: [toUserId], references: [id], onDelete: Restrict)
  adminId        String
  admin          User     @relation("InternalTransferAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  amount         Decimal
  queuedAmount   Decimal
  investedAmount Decimal
  units          Decimal
  navPrice       Decimal
  note           String?
  createdAt      DateTime @default(now())

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@index([adminId, createdAt])
}

enum ProfitShareFrequency {
  WEEKLY
  MONTHLY
}

enum ProfitShareMode {
  PERCENTAGE
  FIXED_TOTAL
}

// One immutable admin-confirmed settlement per week or month. The unique period
// key is the final safeguard against charging the same period twice.
model ProfitShareRun {
  id                  String                  @id @default(cuid())
  frequency           ProfitShareFrequency
  periodKey           String
  cutoffDate          String
  mode                ProfitShareMode
  ratePercent         Decimal?
  fixedAmount         Decimal?
  navPrice            Decimal
  totalEligibleProfit Decimal
  totalCompanyShare   Decimal
  activePeriodKey     String?                 @unique
  companyUserId       String
  companyUser         User                    @relation("ProfitShareCompany", fields: [companyUserId], references: [id], onDelete: Restrict)
  adminId             String
  admin               User                    @relation("ProfitShareAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  reversedAt          DateTime?
  reversedById        String?
  reversedBy          User?                   @relation("ProfitShareReversalAdmin", fields: [reversedById], references: [id], onDelete: Restrict)
  allocations         ProfitShareAllocation[]
  createdAt           DateTime                @default(now())

  @@index([createdAt])
}

// Per-account calculation captured exactly as it was at settlement.
model ProfitShareAllocation {
  id                String         @id @default(cuid())
  runId             String
  run               ProfitShareRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  profitBeforeShare Decimal
  highWaterBefore   Decimal
  eligibleProfit    Decimal
  companyShare      Decimal
  unitsTransferred  Decimal
  highWaterAfter    Decimal
  createdAt         DateTime       @default(now())

  @@unique([runId, userId])
  @@index([userId, createdAt])
}

// The post-fee cumulative-profit high-water mark prevents repeat charges and
// requires an investor to recover losses before further profit sharing.
model ProfitSharePosition {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  highWaterProfit Decimal   @default(0)
  lastRunAt       DateTime?
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Deposits (USDT in)
// ---------------------------------------------------------------------------

enum DepositStatus {
  PENDING
  NEEDS_CORRECTION
  RECEIVED
  QUEUED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum DepositMethod {
  CRYPTO // USDT on TRC20 | ERC20 | BEP20
  BANK // bank transfer / UPI — enabled per investor by an admin
  CASH // physical cash drop-off — enabled per investor by an admin
}

model Deposit {
  id                    String                  @id @default(cuid())
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  method                DepositMethod           @default(CRYPTO)
  // amount is the net USD/USDT share invested after the weekend broker
  // transfer. queuedUsdtAmount is the amount held in the company wallet first.
  amount                Decimal
  queuedUsdtAmount      Decimal?
  inrAmount             Decimal? // INR reported by the investor for BANK and CASH
  reportedUsdtAmount    Decimal? // original crypto amount; preserved after allocation
  network               String? // TRC20 | ERC20 | BEP20 — only for CRYPTO
  txHash                String? // on-chain hash — only for CRYPTO
  reference             String? // UTR / receipt reference — BANK & CASH
  status                DepositStatus           @default(PENDING)
  adminNote             String?
  createdAt             DateTime                @default(now())
  receivedAt            DateTime?
  confirmedAt           DateTime?
  allocationBatchId     String?
  allocationBatch       DepositAllocationBatch? @relation(fields: [allocationBatchId], references: [id], onDelete: SetNull)
  brokerTransferBatchId String?
  brokerTransferBatch   BrokerTransferBatch?    @relation(fields: [brokerTransferBatchId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, method])
  @@index([allocationBatchId])
  @@index([brokerTransferBatchId])
}

// Audit record for converting a group of received INR deposits into USDT held
// in the company wallet. This moves bank/cash receipts into QUEUED.
model DepositAllocationBatch {
  id                String        @id @default(cuid())
  method            DepositMethod
  totalSourceAmount Decimal
  totalUsdt         Decimal
  adminId           String
  admin             User          @relation("DepositAllocationAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  deposits          Deposit[]
  createdAt         DateTime      @default(now())

  @@index([method, createdAt])
  @@index([adminId])
}

// Weekend transfer from the company wallet to the broker. The net amount
// received after transfer fees is distributed proportionally and invested.
model BrokerTransferBatch {
  id                String    @id @default(cuid())
  totalQueuedUsdt   Decimal
  totalReceivedUsdt Decimal
  navPrice          Decimal
  adminId           String
  admin             User      @relation("BrokerTransferAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  deposits          Deposit[]
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([adminId])
}

// ---------------------------------------------------------------------------
// Withdrawals (USDT out) — requested Sunday morning, processed Monday
// ---------------------------------------------------------------------------

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  BROKER_RECEIVED
  INR_READY
  PROCESSED
  REJECTED
  CANCELLED
}

enum WithdrawalMethod {
  CRYPTO // payout to the saved USDT address
  BANK // payout to the saved bank / UPI details
  CASH // cash collection arranged by the team
}

model Withdrawal {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  method              WithdrawalMethod @default(CRYPTO)
  // USD amount requested by the investor and removed from holdings after
  // approval and inclusion in the bulk broker withdrawal.
  amount              Decimal
  requestedInrAmount  Decimal? // estimated INR shown when the USD request was submitted
  requestExchangeRate Decimal? // INR per USD reference rate shown at request time
  fee                 Decimal? // gross USD minus net USDT received from broker
  brokerReceivedUsdt  Decimal?
  convertedInrAmount  Decimal?
  paidAmount          Decimal? // USDT sent for crypto withdrawals
  paidInrAmount       Decimal? // INR paid for bank/cash withdrawals
  unitsRedeemed       Decimal?
  network             String
  address             String
  brokerReference     String?
  conversionReference String?
  txHash              String? // final payout UTR / receipt / crypto tx hash
  status              WithdrawalStatus @default(REQUESTED)
  adminNote           String?
  weekKey             String // e.g. "2026-W23" — the processing week
  createdAt           DateTime         @default(now())
  approvedAt          DateTime?
  brokerReceivedAt    DateTime?
  convertedAt         DateTime?
  processedAt         DateTime?

  @@index([userId, createdAt])
  @@index([status, method])
}

// ---------------------------------------------------------------------------
// Support tickets
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  TicketMessage[]

  @@index([userId, updatedAt])
}

model TicketMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isStaff     Boolean            @default(false)
  body        String
  createdAt   DateTime           @default(now())
  attachments TicketAttachment[]
}

model TicketAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  mimeType  String
  size      Int
  createdAt DateTime      @default(now())

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// MT5 feed (pushed by the external bridge)
// ---------------------------------------------------------------------------

model Mt5Account {
  id         String   @id @default(cuid())
  login      String   @unique
  name       String?
  server     String?
  currency   String   @default("USD")
  balance    Float    @default(0)
  equity     Float    @default(0)
  margin     Float    @default(0)
  freeMargin Float    @default(0)
  updatedAt  DateTime @updatedAt
}

model Mt5Trade {
  id         String    @id @default(cuid())
  ticket     String    @unique // MT5 order/deal id
  symbol     String
  type       String // BUY | SELL
  volume     Float
  openPrice  Float
  closePrice Float?
  profit     Float     @default(0)
  swap       Float     @default(0)
  commission Float     @default(0)
  status     String // OPEN | CLOSED
  openTime   DateTime
  closeTime  DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([status, openTime])
}

// One row per UTC day recording pool NAV — upserted on every MT5 ingest.
// This is what makes honest historical charts possible; history is never
// fabricated, only interpolated between real snapshots.
model NavSnapshot {
  id         String   @id @default(cuid())
  day        String   @unique // "YYYY-MM-DD" (UTC)
  nav        Decimal
  equity     Decimal
  totalUnits Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Key/value settings (performance fee %, etc.)
// ---------------------------------------------------------------------------

model Setting {
  key   String @id
  value String
}
